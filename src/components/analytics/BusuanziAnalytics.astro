<script is:inline>
(function () {
  var SCRIPT_SRC = "https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js";
  var LOADED_ATTR = "data-busuanzi-loaded";

  // 注入 busuanzi 脚本（每次调用都重新注入，确保统计新 URL）
  function injectScript() {
    // 删除旧脚本（如有）
    var old = document.querySelector("script[" + LOADED_ATTR + "]");
    if (old) old.parentNode.removeChild(old);

    // 重置数字占位
    ["busuanzi_value_site_uv", "busuanzi_value_site_pv"].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = "";
    });

    var s = document.createElement("script");
    s.async = true;
    s.setAttribute(LOADED_ATTR, "1");
    s.src = SCRIPT_SRC + "?t=" + Date.now(); // 加时间戳防缓存
    document.head.appendChild(s);
  }

  // 用 IntersectionObserver 懒加载（首屏零开销）
  function observeAndLoad() {
    var target = document.getElementById("busuanzi_value_site_uv")
               || document.getElementById("busuanzi_value_site_pv");
    if (!target) return;

    if (!("IntersectionObserver" in window)) {
      injectScript();
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          injectScript();
          observer.disconnect();
        }
      });
    }, { rootMargin: "200px" });

    observer.observe(target);
  }

  // Swup 切页后：重新触发（页脚是静态区域，DOM 节点还在，直接重注入）
  document.addEventListener("swup:contentReplaced", function () {
    requestAnimationFrame(injectScript);
  });

  // 首次加载
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", observeAndLoad);
  } else {
    observeAndLoad();
  }
})();
</script>
